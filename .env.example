# LLM summaries (required for Groq-backed table/database descriptions)
GROQ_API_KEY=

# Legacy / optional — not used when summariser calls Groq
ANTHROPIC_API_KEY=

# Default paths (optional)
SAMPLE_DATA_PATH=./sample_data
OUTPUT_PATH=./output/generated

# Config used by config/settings.py (optional)
LLM_MODEL=claude-sonnet-4-6
MAX_SAMPLE_ROWS=10000
LLM_CACHE_ENABLED=true
